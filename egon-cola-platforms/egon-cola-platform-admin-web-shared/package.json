{
  "name": "@egon-cola/admin-web-shared",
  "version": "0.1.4",
  "type": "module",
  "files": [
    "dist",
    "favicon.png"
  ],
  "main": "./dist/admin-web-shared.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/admin-web-shared.js",
      "types": "./dist/index.d.ts"
    },
    "./vite-plugin": {
      "import": "./dist/vite-plugin.js",
      "types": "./dist/vite/faviconPlugin.d.ts"
    }
  },
  "scripts": {
    "prebuild": "node scripts/copy-favicon.mjs",
    "build": "tsc -b --emitDeclarationOnly && vite build",
    "postbuild": "rm -rf node_modules",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "release:patch": "npm version patch --no-git-tag-version && npm install --legacy-peer-deps && npm run build && npm publish",
    "release:minor": "npm version minor --no-git-tag-version && npm install --legacy-peer-deps && npm run build && npm publish"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.2",
    "i18next": "^24.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "antd": "^6.5.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^24.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
