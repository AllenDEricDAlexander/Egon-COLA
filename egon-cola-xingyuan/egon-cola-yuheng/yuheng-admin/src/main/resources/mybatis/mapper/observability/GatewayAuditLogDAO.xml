<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.observability.dao.GatewayAuditLogDAO">
    <resultMap id="GatewayAuditLogResultMap" type="top.egon.cola.component.yuheng.admin.observability.domain.po.GatewayAuditLogRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="actor_id" property="actorId"/>
        <result column="actor_type" property="actorType"/>
        <result column="source" property="source"/>
        <result column="request_id" property="requestId"/>
        <result column="trace_id" property="traceId"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="action" property="action"/>
        <result column="before_summary" property="beforeSummary" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="after_summary" property="afterSummary" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="draft_revision" property="draftRevision"/>
        <result column="release_id" property="releaseId"/>
        <result column="successful" property="successful"/>
        <result column="error_code" property="errorCode"/>
        <result column="occurred_at" property="occurredAt" jdbcType="TIMESTAMP"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, actor_id, actor_type, source, request_id, trace_id, resource_type, resource_id, action, before_summary, after_summary, draft_revision, release_id, successful, error_code, occurred_at</sql>
    <select id="selectActiveById" resultMap="GatewayAuditLogResultMap">
        SELECT <include refid="columns"/> FROM gateway_audit_log WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayAuditLogResultMap">
        SELECT <include refid="columns"/> FROM gateway_audit_log WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_audit_log SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
