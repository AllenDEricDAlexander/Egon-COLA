<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.observability.dao.GatewayConsumeFailureDAO">
    <resultMap id="GatewayConsumeFailureResultMap" type="top.egon.cola.component.yuheng.admin.observability.domain.po.GatewayConsumeFailureRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="topic" property="topic"/>
        <result column="partition_no" property="partitionNo"/>
        <result column="offset_no" property="offsetNo"/>
        <result column="event_id" property="eventId"/>
        <result column="failure_code" property="failureCode"/>
        <result column="failure_message" property="failureMessage"/>
        <result column="payload_sha256" property="payloadSha256"/>
        <result column="payload_size" property="payloadSize"/>
        <result column="occurred_at" property="occurredAt" jdbcType="TIMESTAMP"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, topic, partition_no, offset_no, event_id, failure_code, failure_message, payload_sha256, payload_size, occurred_at</sql>
    <select id="selectActiveById" resultMap="GatewayConsumeFailureResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_event_consume_failure WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayConsumeFailureResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_event_consume_failure WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_call_event_consume_failure SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
