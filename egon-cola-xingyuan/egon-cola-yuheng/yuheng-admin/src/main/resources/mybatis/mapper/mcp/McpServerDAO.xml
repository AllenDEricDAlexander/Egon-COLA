<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.mcp.dao.McpServerDAO">
    <resultMap id="McpServerResultMap" type="top.egon.cola.component.yuheng.admin.mcp.domain.po.McpServerRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="server_code" property="serverCode"/>
        <result column="display_name" property="displayName"/>
        <result column="description" property="description"/>
        <result column="instructions" property="instructions"/>
        <result column="dialects" property="dialects" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="resource_uri" property="resourceUri"/>
        <result column="list_cache_ttl_seconds" property="listCacheTtlSeconds"/>
        <result column="enabled" property="enabled"/>
        <result column="revision" property="revision"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, gateway_group_id, server_code, display_name, description, instructions, dialects, resource_uri, list_cache_ttl_seconds, enabled, revision</sql>
    <select id="selectActiveById" resultMap="McpServerResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_server WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="McpServerResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_server WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_mcp_server SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
