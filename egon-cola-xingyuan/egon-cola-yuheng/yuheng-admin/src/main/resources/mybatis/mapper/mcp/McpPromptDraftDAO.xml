<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.mcp.dao.McpPromptDraftDAO">
    <resultMap id="McpPromptDraftResultMap" type="top.egon.cola.component.yuheng.admin.mcp.domain.po.McpPromptDraftPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="server_id" property="serverId"/>
        <result column="prompt_name" property="promptName"/>
        <result column="source_type" property="sourceType"/>
        <result column="operation_id" property="operationId"/>
        <result column="remote_mount_id" property="remoteMountId"/>
        <result column="content" property="content" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="enabled" property="enabled"/>
        <result column="revision" property="revision"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, gateway_group_id, server_id, prompt_name, source_type, operation_id, remote_mount_id, content, enabled, revision</sql>
    <select id="selectActiveById" resultMap="McpPromptDraftResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_prompt_draft WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="McpPromptDraftResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_prompt_draft WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_mcp_prompt_draft SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
