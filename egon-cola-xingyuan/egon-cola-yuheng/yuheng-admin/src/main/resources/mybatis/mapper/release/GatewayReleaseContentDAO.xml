<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.release.dao.GatewayReleaseContentDAO">
    <resultMap id="GatewayReleaseContentResultMap" type="top.egon.cola.component.yuheng.admin.release.domain.po.GatewayReleaseContentPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="release_id" property="releaseId"/>
        <result column="rule_content_sha256" property="ruleContentSha256"/>
        <result column="artifact_sha256" property="artifactSha256"/>
        <result column="canonical_snapshot" property="canonicalSnapshot" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="activation_content" property="activationContent" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="chunk_manifest" property="chunkManifest" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="snapshot_size" property="snapshotSize"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, release_id, rule_content_sha256, artifact_sha256, canonical_snapshot, activation_content, chunk_manifest, snapshot_size</sql>
    <select id="selectActiveById" resultMap="GatewayReleaseContentResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_content WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayReleaseContentResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_content WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_release_content SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
