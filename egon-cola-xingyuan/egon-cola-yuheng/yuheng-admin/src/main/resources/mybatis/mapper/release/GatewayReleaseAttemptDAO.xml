<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.release.dao.GatewayReleaseAttemptDAO">
    <resultMap id="GatewayReleaseAttemptResultMap" type="top.egon.cola.component.yuheng.admin.release.domain.po.GatewayReleaseAttemptRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="release_id" property="releaseId"/>
        <result column="attempt_no" property="attemptNo"/>
        <result column="status" property="status"/>
        <result column="change_id" property="changeId"/>
        <result column="lease_owner" property="leaseOwner"/>
        <result column="lease_until" property="leaseUntil" jdbcType="TIMESTAMP"/>
        <result column="started_at" property="startedAt" jdbcType="TIMESTAMP"/>
        <result column="completed_at" property="completedAt" jdbcType="TIMESTAMP"/>
        <result column="error_code" property="errorCode"/>
        <result column="error_message" property="errorMessage"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, release_id, attempt_no, status, change_id, lease_owner, lease_until, started_at, completed_at, error_code, error_message</sql>
    <select id="selectActiveById" resultMap="GatewayReleaseAttemptResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_attempt WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayReleaseAttemptResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_attempt WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_release_attempt SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
