<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.knowledge.dao.KnowledgeDocumentDAO">
    <resultMap id="KnowledgeDocumentResultMap" type="top.egon.cola.component.yuheng.admin.knowledge.domain.po.KnowledgeDocumentPO">
        <id column="id" property="id"/>
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="kb_id" property="kbId"/>
        <result column="file_name" property="fileName"/>
        <result column="active_revision_id" property="activeRevisionId"/>
        <result column="latest_job_id" property="latestJobId"/>
        <result column="revision" property="revision"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, kb_id, file_name, active_revision_id, latest_job_id, revision</sql>
    <select id="selectActiveById" resultMap="KnowledgeDocumentResultMap">
        SELECT <include refid="columns"/> FROM gateway_knowledge_document WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="KnowledgeDocumentResultMap">
        SELECT <include refid="columns"/> FROM gateway_knowledge_document WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_knowledge_document SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'), version = version + 1,
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
    <!-- Step 12 原子发布：活动版本切换必须是带 expectedRevision 的单语句 CAS（Spec §"切 active"），
         只改 active_revision_id 与 revision/审计/版本列，latest_job_id 与 kb_id 一律不动。
         Step 12 atomic publication: switching the active revision is a single-statement CAS carrying expectedRevision
         (Spec §"switch active"); only active_revision_id plus the revision/audit/version columns move, while latest_job_id
         and kb_id never do. -->
    <!-- 发布 CAS 也是一条带技术 version 的版本化 UPDATE，因此与生成的 deleteVersionedById 同形地携带 et：
         守卫边界（validateVersionedUpdate）要求 WHERE 恰有一个绑定的 Long version 谓词、SET 里有
         update_user_id = 守卫上下文用户与 Instant 型 update_time；业务 revision = expectedRevision 是另一列，
         不能替代技术 version。裸 id/tenantId/kbId 参数无法满足这两条，故不注册豁免而是扩签名（上游组件不可改）。
         Publication CAS is a versioned UPDATE carrying the technical version too, so it takes et in the shape of the
         generated deleteVersionedById: the guarded boundary (validateVersionedUpdate) demands exactly one bound Long version
         predicate in the WHERE plus update_user_id = the guard-context user and an Instant update_time in the SET, and the
         business revision = expectedRevision predicate is a different column that cannot substitute. Bare id/tenantId/kbId
         parameters cannot satisfy those two rules, so the signature carries et instead of registering an exception (upstream
         components are off-limits). -->
    <update id="activateRevision">
        UPDATE gateway_knowledge_document SET active_revision_id = #{activeRevisionId}, revision = revision + 1,
            version = version + 1, update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND kb_id = #{et.kbId} AND revision = #{expectedRevision}
            AND deleted_at IS NULL AND version = #{et.version}
    </update>
</mapper>
