<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.observability.dao.GatewayCallMetricMinuteDAO">
    <resultMap id="GatewayCallMetricMinuteResultMap" type="top.egon.cola.component.yuheng.admin.observability.domain.po.GatewayCallMetricMinutePO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="bucket_at" property="bucketAt" jdbcType="TIMESTAMP"/>
        <result column="env" property="env"/>
        <result column="namespace" property="namespace"/>
        <result column="protocol" property="protocol"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="request_count" property="requestCount"/>
        <result column="error_count" property="errorCount"/>
        <result column="duration_total_ms" property="durationTotalMs"/>
        <result column="duration_max_ms" property="durationMaxMs"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, bucket_at, env, namespace, protocol, gateway_group_id, request_count, error_count, duration_total_ms, duration_max_ms</sql>
    <select id="selectActiveById" resultMap="GatewayCallMetricMinuteResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_metric_minute WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayCallMetricMinuteResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_metric_minute WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_call_metric_minute SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
