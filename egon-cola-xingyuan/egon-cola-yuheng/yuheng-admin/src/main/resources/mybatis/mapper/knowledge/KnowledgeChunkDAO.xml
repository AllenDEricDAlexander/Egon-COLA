<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.knowledge.dao.KnowledgeChunkDAO">
    <resultMap id="KnowledgeChunkResultMap" type="top.egon.cola.component.yuheng.admin.knowledge.domain.po.KnowledgeChunkPO">
        <id column="id" property="id"/>
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="kb_id" property="kbId"/>
        <result column="revision_id" property="revisionId"/>
        <result column="chunk_index" property="chunkIndex"/>
        <result column="content" property="content"/>
        <result column="metadata" property="metadata" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="content_hash" property="contentHash"/>
        <result column="embedding_space_id" property="embeddingSpaceId"/>
        <result column="dimensions" property="dimensions"/>
        <result column="embedding" property="embedding" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayVectorTypeHandler"/>
        <result column="revision" property="revision"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, kb_id, revision_id, chunk_index, content, metadata, content_hash, embedding_space_id, dimensions, embedding, revision</sql>
    <select id="selectActiveById" resultMap="KnowledgeChunkResultMap">
        SELECT <include refid="columns"/> FROM gateway_knowledge_chunk WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="KnowledgeChunkResultMap">
        SELECT <include refid="columns"/> FROM gateway_knowledge_chunk WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_knowledge_chunk SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'), version = version + 1,
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
