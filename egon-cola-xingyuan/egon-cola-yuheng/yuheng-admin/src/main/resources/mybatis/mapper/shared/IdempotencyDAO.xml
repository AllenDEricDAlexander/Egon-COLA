<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.shared.dao.IdempotencyDAO">
    <resultMap id="IdempotencyResultMap" type="top.egon.cola.component.yuheng.admin.shared.domain.po.IdempotencyRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="scope_type" property="scopeType"/>
        <result column="scope_id" property="scopeId"/>
        <result column="idempotency_key" property="idempotencyKey"/>
        <result column="payload_sha256" property="payloadSha256"/>
        <result column="resource_id" property="resourceId"/>
        <result column="response_content" property="responseContent" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="expires_at" property="expiresAt" jdbcType="TIMESTAMP"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, scope_type, scope_id, idempotency_key, payload_sha256, resource_id, response_content, expires_at</sql>
    <select id="selectActiveById" resultMap="IdempotencyResultMap">
        SELECT <include refid="columns"/> FROM gateway_idempotency_record WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="IdempotencyResultMap">
        SELECT <include refid="columns"/> FROM gateway_idempotency_record WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_idempotency_record SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
