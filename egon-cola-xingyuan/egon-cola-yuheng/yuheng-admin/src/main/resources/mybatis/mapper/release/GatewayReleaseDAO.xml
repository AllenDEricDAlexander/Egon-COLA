<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.release.dao.GatewayReleaseDAO">
    <resultMap id="GatewayReleaseResultMap" type="top.egon.cola.component.yuheng.admin.release.domain.po.GatewayReleaseRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="draft_revision" property="draftRevision"/>
        <result column="based_on_release_id" property="basedOnReleaseId"/>
        <result column="rollback_of_release_id" property="rollbackOfReleaseId"/>
        <result column="status" property="status"/>
        <result column="partial_applied" property="partialApplied"/>
        <result column="change_id" property="changeId"/>
        <result column="validation_report" property="validationReport" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="structured_diff" property="structuredDiff" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="change_reason" property="changeReason"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, gateway_group_id, draft_revision, based_on_release_id, rollback_of_release_id, status, partial_applied, change_id, validation_report, structured_diff, change_reason</sql>
    <select id="selectActiveById" resultMap="GatewayReleaseResultMap">
        SELECT <include refid="columns"/> FROM gateway_release WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayReleaseResultMap">
        SELECT <include refid="columns"/> FROM gateway_release WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_release SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
