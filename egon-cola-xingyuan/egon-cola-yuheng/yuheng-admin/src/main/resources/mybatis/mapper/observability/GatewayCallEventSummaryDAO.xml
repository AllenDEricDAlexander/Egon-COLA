<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.observability.dao.GatewayCallEventSummaryDAO">
    <resultMap id="GatewayCallEventSummaryResultMap" type="top.egon.cola.component.yuheng.admin.observability.domain.po.GatewayCallEventSummaryPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="event_id" property="eventId"/>
        <result column="trace_id" property="traceId"/>
        <result column="occurred_at" property="occurredAt" jdbcType="TIMESTAMP"/>
        <result column="completed_at" property="completedAt" jdbcType="TIMESTAMP"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="protocol" property="protocol"/>
        <result column="access_zone" property="accessZone"/>
        <result column="env" property="env"/>
        <result column="namespace" property="namespace"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="operation_id" property="operationId"/>
        <result column="route_id" property="routeId"/>
        <result column="result_category" property="resultCategory"/>
        <result column="gateway_error_code" property="gatewayErrorCode"/>
        <result column="http_status" property="httpStatus"/>
        <result column="grpc_status" property="grpcStatus"/>
        <result column="engine_node_id" property="engineNodeId"/>
        <result column="provider_service" property="providerService"/>
        <result column="attempt_count" property="attemptCount"/>
        <result column="expires_at" property="expiresAt" jdbcType="TIMESTAMP"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, event_id, trace_id, occurred_at, completed_at, duration_ms, protocol, access_zone, env, namespace, gateway_group_id, operation_id, route_id, result_category, gateway_error_code, http_status, grpc_status, engine_node_id, provider_service, attempt_count, expires_at</sql>
    <select id="selectActiveById" resultMap="GatewayCallEventSummaryResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_event_summary WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayCallEventSummaryResultMap">
        SELECT <include refid="columns"/> FROM gateway_call_event_summary WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_call_event_summary SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
