<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.mcp.dao.McpTaskDAO">
    <resultMap id="McpTaskResultMap" type="top.egon.cola.component.yuheng.admin.mcp.domain.po.McpTaskRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="principal_fingerprint" property="principalFingerprint"/>
        <result column="subject_id" property="subjectId"/>
        <result column="client_id" property="clientId"/>
        <result column="server_code" property="serverCode"/>
        <result column="tool_name" property="toolName"/>
        <result column="request_digest" property="requestDigest"/>
        <result column="state" property="state"/>
        <result column="input_payload" property="inputPayload" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="result_payload" property="resultPayload" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="error_payload" property="errorPayload" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="worker_owner" property="workerOwner"/>
        <result column="lease_until" property="leaseUntil" jdbcType="TIMESTAMP"/>
        <result column="execution_deadline" property="executionDeadline" jdbcType="TIMESTAMP"/>
        <result column="expires_at" property="expiresAt" jdbcType="TIMESTAMP"/>
        <result column="attempt_count" property="attemptCount"/>
        <result column="max_attempts" property="maxAttempts"/>
        <result column="revision" property="revision"/>
        <result column="task_key" property="taskKey"/>
        <result column="subject_tenant_id" property="subjectTenantId"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, principal_fingerprint, subject_id, client_id, server_code, tool_name, request_digest, state, input_payload, result_payload, error_payload, worker_owner, lease_until, execution_deadline, expires_at, attempt_count, max_attempts, revision, task_key, subject_tenant_id</sql>
    <select id="selectActiveById" resultMap="McpTaskResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_task_instance WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="McpTaskResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_task_instance WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_mcp_task_instance SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'), version = version + 1,
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
