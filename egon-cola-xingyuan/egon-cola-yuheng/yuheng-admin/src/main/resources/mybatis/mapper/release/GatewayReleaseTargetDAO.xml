<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.release.dao.GatewayReleaseTargetDAO">
    <resultMap id="GatewayReleaseTargetResultMap" type="top.egon.cola.component.yuheng.admin.release.domain.po.GatewayReleaseTargetRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="release_id" property="releaseId"/>
        <result column="attempt_no" property="attemptNo"/>
        <result column="instance_id" property="instanceId"/>
        <result column="lease_id" property="leaseId"/>
        <result column="status" property="status"/>
        <result column="applied_version" property="appliedVersion"/>
        <result column="applied_artifact_sha256" property="appliedArtifactSha256"/>
        <result column="error_code" property="errorCode"/>
        <result column="observed_at" property="observedAt" jdbcType="TIMESTAMP"/>
        <result column="engine_role" property="engineRole"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, release_id, attempt_no, instance_id, lease_id, status, applied_version, applied_artifact_sha256, error_code, observed_at, engine_role</sql>
    <select id="selectActiveById" resultMap="GatewayReleaseTargetResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_target WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayReleaseTargetResultMap">
        SELECT <include refid="columns"/> FROM gateway_release_target WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_release_target SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
