<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.openapi.dao.GatewayOpenApiSyncDAO">
    <resultMap id="GatewayOpenApiSyncResultMap" type="top.egon.cola.component.yuheng.admin.openapi.domain.po.GatewayOpenApiSyncRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="application_id" property="applicationId"/>
        <result column="build_id" property="buildId"/>
        <result column="artifact_version" property="artifactVersion"/>
        <result column="openapi_group" property="openapiGroup"/>
        <result column="provider_service_name" property="providerServiceName"/>
        <result column="provider_group" property="providerGroup"/>
        <result column="provider_version" property="providerVersion"/>
        <result column="status" property="status"/>
        <result column="latest_snapshot_id" property="latestSnapshotId"/>
        <result column="definition_set_id" property="definitionSetId"/>
        <result column="last_instance_id" property="lastInstanceId"/>
        <result column="attempt_count" property="attemptCount"/>
        <result column="last_error_code" property="lastErrorCode"/>
        <result column="last_error_message" property="lastErrorMessage"/>
        <result column="first_discovered_at" property="firstDiscoveredAt" jdbcType="TIMESTAMP"/>
        <result column="last_attempt_at" property="lastAttemptAt" jdbcType="TIMESTAMP"/>
        <result column="last_success_at" property="lastSuccessAt" jdbcType="TIMESTAMP"/>
        <result column="next_retry_at" property="nextRetryAt" jdbcType="TIMESTAMP"/>
        <result column="revision" property="revision"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, application_id, build_id, artifact_version, openapi_group, provider_service_name, provider_group, provider_version, status, latest_snapshot_id, definition_set_id, last_instance_id, attempt_count, last_error_code, last_error_message, first_discovered_at, last_attempt_at, last_success_at, next_retry_at, revision</sql>
    <select id="selectActiveById" resultMap="GatewayOpenApiSyncResultMap">
        SELECT <include refid="columns"/> FROM gateway_openapi_sync_state WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="GatewayOpenApiSyncResultMap">
        SELECT <include refid="columns"/> FROM gateway_openapi_sync_state WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_openapi_sync_state SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'), version = version + 1,
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
