<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.yuheng.admin.mcp.dao.McpArtifactMetadataDAO">
    <resultMap id="McpArtifactMetadataResultMap" type="top.egon.cola.component.yuheng.admin.mcp.domain.po.McpArtifactMetadataRecordPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="version" property="version"/>
        <result column="gateway_group_id" property="gatewayGroupId"/>
        <result column="app_code" property="appCode"/>
        <result column="app_version" property="appVersion"/>
        <result column="display_name" property="displayName"/>
        <result column="resource_uri" property="resourceUri"/>
        <result column="artifact_reference" property="artifactReference"/>
        <result column="artifact_sha256" property="artifactSha256"/>
        <result column="size_bytes" property="sizeBytes"/>
        <result column="mime_type" property="mimeType"/>
        <result column="content_security_policy" property="contentSecurityPolicy"/>
        <result column="permission_manifest" property="permissionManifest" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="allowed_origins" property="allowedOrigins" jdbcType="OTHER" typeHandler="top.egon.cola.component.yuheng.admin.shared.dao.typehandler.GatewayJsonbTypeHandler"/>
        <result column="status" property="status"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, gateway_group_id, app_code, app_version, display_name, resource_uri, artifact_reference, artifact_sha256, size_bytes, mime_type, content_security_policy, permission_manifest, allowed_origins, status</sql>
    <select id="selectActiveById" resultMap="McpArtifactMetadataResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_app_artifact WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="McpArtifactMetadataResultMap">
        SELECT <include refid="columns"/> FROM gateway_mcp_app_artifact WHERE deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <update id="deleteVersionedById">
        UPDATE gateway_mcp_app_artifact SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId}, update_time = #{et.updateTime,jdbcType=TIMESTAMP}, version = version + 1
        WHERE id = #{et.id} AND tenant_id = #{et.tenantId} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
</mapper>
