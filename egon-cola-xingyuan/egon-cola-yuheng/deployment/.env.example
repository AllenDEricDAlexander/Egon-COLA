POSTGRES_PASSWORD=replace-with-local-password
TIANSHU_RUNTIME_ACCESS_KEY=replace-with-tianshu-runtime-access-key
TIANSHU_RUNTIME_SECRET_KEY=replace-with-tianshu-runtime-secret-key-at-least-32-bytes
TIANSHU_REGISTRY_ACCESS_KEY=replace-with-tianshu-registry-access-key
TIANSHU_REGISTRY_SECRET_KEY=replace-with-tianshu-registry-secret-key-at-least-32-bytes
TIANSHU_MANAGEMENT_ACCESS_KEY=replace-with-tianshu-management-access-key
TIANSHU_MANAGEMENT_SECRET_KEY=replace-with-tianshu-management-secret-key-at-least-32-bytes
YUHENG_MASTER_KEY_BASE64=replace-with-base64-encoded-32-byte-key
YUHENG_ADMIN_JWT_HMAC_SECRET_BASE64=replace-with-base64-encoded-32-byte-key
YUHENG_BIZ_CODE=default
YUHENG_ENV=local
YUHENG_NAMESPACE=default
YUHENG_GROUP_CODE=default
YUHENG_RPC_SERVICE_NAME=egon-yuheng-rpc
YUHENG_RPC_GROUP=default
YUHENG_RPC_VERSION=1.0.0
DEMO_SERVICE_VERSION=1.0.0-demo

# Separate MCP SDK/Registry credentials; never reuse the API/RPC role secrets.
YUHENG_MCP_TIANSHU_RUNTIME_ACCESS_KEY=replace-with-mcp-tianshu-runtime-access-key
YUHENG_MCP_TIANSHU_RUNTIME_SECRET_KEY=replace-with-mcp-runtime-secret-at-least-32-bytes
YUHENG_MCP_TIANSHU_REGISTRY_ACCESS_KEY=replace-with-mcp-tianshu-registry-access-key
YUHENG_MCP_TIANSHU_REGISTRY_SECRET_KEY=replace-with-mcp-registry-secret-at-least-32-bytes
# Provision distinct process Resources in Tianquan-Shoubing; business MCP Server Resources are unchanged.
YUHENG_API_RESOURCE_SERVER_ID=replace-with-api-resource-server-id
YUHENG_API_RESOURCE_URI=https://api.egon.internal/local/yuheng-biz-gateway
YUHENG_MCP_RESOURCE_SERVER_ID=replace-with-mcp-resource-server-id
YUHENG_MCP_RESOURCE_URI=https://api.egon.internal/local/yuheng-mcp-gateway
TIANQUAN_SHOUBING_OAUTH_ISSUER=https://tianquan-shoubing.example.invalid
TIANQUAN_SHOUBING_JWK_SET_URI=https://tianquan-shoubing.example.invalid/oauth2/jwks
# Existing shared artifact root; provision owner UID/GID 10001 before starting either MCP replica.
YUHENG_MCP_ARTIFACT_DIRECTORY=/absolute/path/to/yuheng-mcp-artifacts
YUHENG_TLS_DIRECTORY=/absolute/path/to/yuheng-tls
