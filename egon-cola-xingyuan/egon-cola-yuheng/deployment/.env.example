POSTGRES_PASSWORD=replace-with-local-password
DDC_RUNTIME_ACCESS_KEY=replace-with-ddc-runtime-access-key
DDC_RUNTIME_SECRET_KEY=replace-with-ddc-runtime-secret-key-at-least-32-bytes
DDC_REGISTRY_ACCESS_KEY=replace-with-ddc-registry-access-key
DDC_REGISTRY_SECRET_KEY=replace-with-ddc-registry-secret-key-at-least-32-bytes
DDC_MANAGEMENT_ACCESS_KEY=replace-with-ddc-management-access-key
DDC_MANAGEMENT_SECRET_KEY=replace-with-ddc-management-secret-key-at-least-32-bytes
GATEWAY_MASTER_KEY_BASE64=replace-with-base64-encoded-32-byte-key
GATEWAY_ADMIN_JWT_HMAC_SECRET_BASE64=replace-with-base64-encoded-32-byte-key
GATEWAY_BIZ_CODE=default
GATEWAY_ENV=local
GATEWAY_NAMESPACE=default
GATEWAY_GROUP_CODE=default
GATEWAY_RPC_SERVICE_NAME=egon-gateway-rpc
GATEWAY_RPC_GROUP=default
GATEWAY_RPC_VERSION=1.0.0
DEMO_SERVICE_VERSION=1.0.0-demo

# Separate MCP SDK/Registry credentials; never reuse the API/RPC role secrets.
GATEWAY_MCP_DDC_RUNTIME_ACCESS_KEY=replace-with-mcp-ddc-runtime-access-key
GATEWAY_MCP_DDC_RUNTIME_SECRET_KEY=replace-with-mcp-runtime-secret-at-least-32-bytes
GATEWAY_MCP_DDC_REGISTRY_ACCESS_KEY=replace-with-mcp-ddc-registry-access-key
GATEWAY_MCP_DDC_REGISTRY_SECRET_KEY=replace-with-mcp-registry-secret-at-least-32-bytes
# Provision distinct process Resources in IdP; business MCP Server Resources are unchanged.
GATEWAY_API_RESOURCE_SERVER_ID=replace-with-api-resource-server-id
GATEWAY_API_RESOURCE_URI=https://api.egon.internal/local/gateway-engine
GATEWAY_MCP_RESOURCE_SERVER_ID=replace-with-mcp-resource-server-id
GATEWAY_MCP_RESOURCE_URI=https://api.egon.internal/local/gateway-mcp-engine
IDP_OAUTH_ISSUER=https://idp.example.invalid
IDP_JWK_SET_URI=https://idp.example.invalid/oauth2/jwks
# Existing shared artifact root; provision owner UID/GID 10001 before starting either MCP replica.
GATEWAY_MCP_ARTIFACT_DIRECTORY=/absolute/path/to/gateway-mcp-artifacts
GATEWAY_TLS_DIRECTORY=/absolute/path/to/gateway-tls
