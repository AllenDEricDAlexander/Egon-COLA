#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\\' )
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.course.repo.mapper.CourseScheduleMapper">
    <resultMap id="CourseScheduleResultMap" type="${package}.infrastructure.course.repo.po.CourseSchedulePo">
        <id column="id" property="id"/>
        <result column="course_id" property="courseId"/>
        <result column="class_id" property="classId"/>
        <result column="starts_at" property="startsAt"/>
        <result column="ends_at" property="endsAt"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByCourseIdAndId" resultMap="CourseScheduleResultMap">
        SELECT id, course_id, class_id, starts_at, ends_at, status, created_at, updated_at
        FROM course_schedule
        WHERE course_id = #{courseId} AND id = #{id}
    </select>

    <select id="selectOverlapping" resultMap="CourseScheduleResultMap">
        SELECT id, course_id, class_id, starts_at, ends_at, status, created_at, updated_at
        FROM course_schedule
        WHERE course_id = #{courseId}
          AND class_id = #{classId}
          AND starts_at &lt; #{endsAt}
          AND ends_at &gt; #{startsAt}
        ORDER BY starts_at ASC, id ASC
    </select>
</mapper>
