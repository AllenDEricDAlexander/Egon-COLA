#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\\' )
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.exam.repo.mapper.ExamPaperMapper">
    <resultMap id="ExamPaperResultMap" type="${package}.infrastructure.exam.repo.po.ExamPaperPo">
        <id column="id" property="id"/>
        <result column="exam_id" property="examId"/>
        <result column="title" property="title"/>
        <result column="total_points" property="totalPoints"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByExamIdAndId" resultMap="ExamPaperResultMap">
        SELECT id, exam_id, title, total_points, status, created_at, updated_at
        FROM exam_paper
        WHERE exam_id = #{examId} AND id = #{id}
    </select>

    <select id="selectByExamId" resultMap="ExamPaperResultMap">
        SELECT id, exam_id, title, total_points, status, created_at, updated_at
        FROM exam_paper
        WHERE exam_id = #{examId}
    </select>
</mapper>
