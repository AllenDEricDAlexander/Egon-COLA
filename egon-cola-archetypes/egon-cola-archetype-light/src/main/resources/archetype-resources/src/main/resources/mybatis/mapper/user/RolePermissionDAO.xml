<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.user.repo.dao.RolePermissionDAO">
    <sql id="rolePermissionColumns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
        role_code, permission_code
    </sql>
    <select id="selectByRoleCodeIn"
            resultType="${package}.infrastructure.user.repo.po.RolePermissionPO">
        SELECT <include refid="rolePermissionColumns"/> FROM role_permissions
        WHERE role_code IN
        <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
        ORDER BY id
    </select>
</mapper>
