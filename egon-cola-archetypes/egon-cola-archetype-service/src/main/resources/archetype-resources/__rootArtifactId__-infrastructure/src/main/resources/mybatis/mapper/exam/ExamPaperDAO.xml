#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\\' )
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.exam.repo.dao.ExamPaperDAO">
    <resultMap id="ExamPaperResultMap" type="${package}.infrastructure.exam.repo.po.ExamPaperPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="exam_id" property="examId"/>
        <result column="title" property="title"/>
        <result column="total_points" property="totalPoints"/>
        <result column="status" property="status"/>
    </resultMap>
    <select id="selectByExamId" resultMap="ExamPaperResultMap">
        SELECT id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
               exam_id, title, total_points, status
        FROM evaluation_exam_paper
        WHERE exam_id = #{examId} AND is_deleted = FALSE
        ORDER BY id ASC
        LIMIT 1
    </select>
    <select id="selectAllByExamId" resultMap="ExamPaperResultMap">
        SELECT id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
               exam_id, title, total_points, status
        FROM evaluation_exam_paper
        WHERE exam_id = #{examId} AND is_deleted = FALSE
        ORDER BY id ASC
    </select>
</mapper>
