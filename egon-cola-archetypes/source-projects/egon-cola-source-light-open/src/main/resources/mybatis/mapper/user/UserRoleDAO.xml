<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.archetype.source.lightopen.infrastructure.user.repo.dao.UserRoleDAO">
    <sql id="userRoleColumns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
        user_id, role_code
    </sql>
    <select id="selectByUserId" resultType="top.egon.cola.archetype.source.lightopen.infrastructure.user.repo.po.UserRolePO">
        SELECT <include refid="userRoleColumns"/> FROM light_user_roles
        WHERE user_id = #{userId}
        ORDER BY id
    </select>
</mapper>
