<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.archetype.source.lightopen.infrastructure.teaching.repo.dao.CourseDAO">
    <sql id="courseColumns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
        course_code, name, status
    </sql>
    <select id="selectByCourseCode" resultType="top.egon.cola.archetype.source.lightopen.infrastructure.teaching.repo.po.CoursePO">
        SELECT <include refid="courseColumns"/> FROM light_courses
        WHERE course_code = #{courseCode}
        ORDER BY id
    </select>
</mapper>
