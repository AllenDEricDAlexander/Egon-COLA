<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.archetype.source.lightopen.infrastructure.user.repo.dao.UserDAO">
    <sql id="userColumns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
        external_id, name, email, status
    </sql>
    <select id="selectByExternalId"
            resultType="top.egon.cola.archetype.source.lightopen.infrastructure.user.repo.po.UserPO">
        SELECT <include refid="userColumns"/> FROM light_users
        WHERE external_id = #{externalId}
        ORDER BY id
    </select>
</mapper>
