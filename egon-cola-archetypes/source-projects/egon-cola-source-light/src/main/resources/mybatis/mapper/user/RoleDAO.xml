<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.archetype.source.light.infrastructure.user.repo.dao.RoleDAO">
    <sql id="roleColumns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
        code, name, status
    </sql>
    <select id="selectByCode" resultType="top.egon.cola.archetype.source.light.infrastructure.user.repo.po.RolePO">
        SELECT <include refid="roleColumns"/> FROM roles
        WHERE code = #{code}
        ORDER BY id
    </select>
</mapper>
