COMPOSE_PROJECT_NAME=egon-cola-source-service
REGISTRY=
REGISTRY_NAMESPACE=
IMAGE_NAME=egon-cola-source-service
IMAGE_TAG=
APPLICATION_PORT=8081
RPC_PORT=50051
APP_MEMORY_LIMIT=1g
APP_CPUS=1.0

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=student_management_evaluation
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_MASTER_DATA_PORT=5432
POSTGRES_SHARD_0_PORT=5433
POSTGRES_SHARD_1_PORT=5434

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=

RABBITMQ_IMAGE=rabbitmq:4-management
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=


ORGANIZATION_FACADE_ENABLED=

# Supply an existing Tianshu deployment; these endpoints are not bundled containers.
RPC_ADVERTISED_HOST=
HTTP_ADVERTISED_HOST=
TIANSHU_RPC_TARGET=
TIANSHU_BIZ_CODE=student-management
TIANSHU_APP_CODE=egon-cola-source-service
TIANSHU_NAMESPACE=default
TIANSHU_REGISTRATION_RESOURCE_URI=
TIANSHU_REDIS_HOST=
TIANSHU_REDIS_PORT=6379
TIANSHU_REDIS_PASSWORD=
TIANSHU_RUNTIME_ACCESS_KEY=
TIANSHU_RUNTIME_SECRET_KEY=
TIANSHU_REGISTRY_ACCESS_KEY=
TIANSHU_REGISTRY_SECRET_KEY=
RPC_TLS_ENABLED=true
RPC_DEVELOPMENT_PLAINTEXT=false
RPC_CERTIFICATE_CHAIN_PATH=
RPC_PRIVATE_KEY_PATH=
RPC_TRUST_CERTIFICATE_COLLECTION_PATH=
TIANSHU_RPC_TLS_ENABLED=true
TIANSHU_RPC_DEVELOPMENT_PLAINTEXT=false
TIANSHU_RPC_CERTIFICATE_CHAIN_PATH=
TIANSHU_RPC_PRIVATE_KEY_PATH=
TIANSHU_RPC_TRUST_CERTIFICATE_COLLECTION_PATH=

# Tianquan-Shoubing SERVICE token registration; configure a client allowed tianshu:registration:write.
TIANQUAN_SHOUBING_ISSUER=
TIANQUAN_SHOUBING_JWK_SET_URI=
TIANQUAN_SHOUBING_RESOURCE_SERVER_ID=
TIANQUAN_SHOUBING_RESOURCE_URI=
TIANQUAN_SHOUBING_SERVICE_APP_ID=
TIANQUAN_SHOUBING_CLIENT_ID=
TIANQUAN_SHOUBING_CLIENT_SECRET=
TIANQUAN_SHOUBING_TOKEN_URI=

# Exact native organization provider scope in the existing Tianshu environment.
ORGANIZATION_FACADE_BIZ_CODE=student-management
ORGANIZATION_FACADE_APP_CODE=
ORGANIZATION_FACADE_SERVICE_VERSION=1.0
ORGANIZATION_FACADE_TIMEOUT_MS=3000
