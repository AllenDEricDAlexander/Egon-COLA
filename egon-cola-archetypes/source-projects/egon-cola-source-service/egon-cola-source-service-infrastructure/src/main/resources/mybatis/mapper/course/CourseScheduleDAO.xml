<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.archetype.source.service.infrastructure.course.repo.dao.CourseScheduleDAO">
    <resultMap id="CourseScheduleResultMap" type="top.egon.cola.archetype.source.service.infrastructure.course.repo.po.CourseSchedulePO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="course_id" property="courseId"/>
        <result column="class_id" property="classId"/>
        <result column="starts_at" property="startsAt"/>
        <result column="ends_at" property="endsAt"/>
        <result column="status" property="status"/>
    </resultMap>
    <select id="selectOverlapping" resultMap="CourseScheduleResultMap">
        SELECT id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
               course_id, class_id, starts_at, ends_at, status
        FROM evaluation_course_schedule
        WHERE course_id = #{courseId} AND class_id = #{classId}
          AND starts_at &lt; #{endsAt} AND ends_at &gt; #{startsAt}
          AND is_deleted = FALSE
        ORDER BY starts_at ASC, id ASC
    </select>
</mapper>
