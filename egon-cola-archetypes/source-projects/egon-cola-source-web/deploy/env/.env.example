COMPOSE_PROJECT_NAME=egon-cola-source-web
IMAGE_NAME=egon-cola-source-web
IMAGE_TAG=local
APPLICATION_PORT=8080
RPC_PORT=50051

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=student_management_organization
POSTGRES_USER=student_management_organization
POSTGRES_PASSWORD=local-postgres
POSTGRES_MASTER_DATA_PORT=5432
POSTGRES_SHARD_0_PORT=5433
POSTGRES_SHARD_1_PORT=5434

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=local-redis
REDIS_PORT=6379

RABBITMQ_IMAGE=rabbitmq:4-management
RABBITMQ_USERNAME=student_management_organization
RABBITMQ_PASSWORD=local-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672


EVALUATION_FACADE_ENABLED=false

# Supply an existing DDC deployment; these endpoints are not bundled containers.
RPC_ADVERTISED_HOST=
HTTP_ADVERTISED_HOST=
DDC_RPC_TARGET=
DDC_BIZ_CODE=student-management
DDC_APP_CODE=egon-cola-source-web
DDC_NAMESPACE=default
DDC_REGISTRATION_RESOURCE_URI=
DDC_REDIS_HOST=
DDC_REDIS_PORT=6379
DDC_REDIS_PASSWORD=
DDC_RUNTIME_ACCESS_KEY=
DDC_RUNTIME_SECRET_KEY=
DDC_REGISTRY_ACCESS_KEY=
DDC_REGISTRY_SECRET_KEY=
RPC_TLS_ENABLED=false
RPC_DEVELOPMENT_PLAINTEXT=true
RPC_CERTIFICATE_CHAIN_PATH=
RPC_PRIVATE_KEY_PATH=
RPC_TRUST_CERTIFICATE_COLLECTION_PATH=
DDC_RPC_TLS_ENABLED=false
DDC_RPC_DEVELOPMENT_PLAINTEXT=true
DDC_RPC_CERTIFICATE_CHAIN_PATH=
DDC_RPC_PRIVATE_KEY_PATH=
DDC_RPC_TRUST_CERTIFICATE_COLLECTION_PATH=

# IdP SERVICE token registration; configure a client allowed ddc:registration:write.
IDP_ISSUER=
IDP_JWK_SET_URI=
IDP_RESOURCE_SERVER_ID=
IDP_RESOURCE_URI=
IDP_SERVICE_APP_ID=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_TOKEN_URI=

# Exact native evaluation provider scope in the existing DDC environment.
EVALUATION_FACADE_BIZ_CODE=student-management
EVALUATION_FACADE_APP_CODE=
EVALUATION_FACADE_SERVICE_VERSION=1.0
EVALUATION_FACADE_TIMEOUT_MS=3000
