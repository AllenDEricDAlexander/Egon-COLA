<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.teaching.repo.mapper.ClassCourseScheduleMapper">
    <resultMap id="ScheduleResultMap"
               type="${package}.infrastructure.teaching.repo.po.ClassCourseSchedulePO">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="schoolClassId" column="school_class_id" jdbcType="BIGINT"/>
        <result property="courseId" column="course_id" jdbcType="BIGINT"/>
        <result property="startsAt" column="starts_at" jdbcType="TIMESTAMP"/>
        <result property="endsAt" column="ends_at" jdbcType="TIMESTAMP"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findBySchoolClassIdOrderByStartsAt" resultMap="ScheduleResultMap">
        SELECT id, school_class_id, course_id, starts_at, ends_at, created_at
        FROM class_course_schedules
        WHERE school_class_id = #{schoolClassId,jdbcType=BIGINT}
        ORDER BY starts_at, id
    </select>

    <insert id="insertSchedule"
            parameterType="${package}.infrastructure.teaching.repo.po.ClassCourseSchedulePO">
        INSERT INTO class_course_schedules
            (id, school_class_id, course_id, starts_at, ends_at, created_at)
        VALUES
            (#{id,jdbcType=BIGINT}, #{schoolClassId,jdbcType=BIGINT}, #{courseId,jdbcType=BIGINT},
             #{startsAt,jdbcType=TIMESTAMP}, #{endsAt,jdbcType=TIMESTAMP},
             #{createdAt,jdbcType=TIMESTAMP})
    </insert>
</mapper>
