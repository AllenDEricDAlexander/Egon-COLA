<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.user.repo.mapper.UserRoleMapper">
    <resultMap id="UserRoleResultMap" type="${package}.infrastructure.user.repo.po.UserRolePO">
        <id property="userId" column="user_id" jdbcType="BIGINT"/>
        <id property="roleCode" column="role_code" jdbcType="VARCHAR"/>
        <result property="assignedAt" column="assigned_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findByUserId" resultMap="UserRoleResultMap">
        SELECT user_id, role_code, assigned_at
        FROM user_roles
        WHERE user_id = #{userId,jdbcType=BIGINT}
        ORDER BY role_code
    </select>

    <insert id="insertRelation" parameterType="${package}.infrastructure.user.repo.po.UserRolePO">
        INSERT INTO user_roles (user_id, role_code, assigned_at)
        VALUES (#{userId,jdbcType=BIGINT}, #{roleCode,jdbcType=VARCHAR},
                #{assignedAt,jdbcType=TIMESTAMP})
    </insert>
</mapper>
