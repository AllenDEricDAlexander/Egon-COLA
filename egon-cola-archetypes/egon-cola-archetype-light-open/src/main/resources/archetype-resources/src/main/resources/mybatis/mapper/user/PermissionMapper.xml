<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.user.repo.mapper.PermissionMapper">
    <resultMap id="PermissionResultMap" type="${package}.infrastructure.user.repo.po.PermissionPO">
        <id property="code" column="code" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findByCodesOrderByCode" resultMap="PermissionResultMap">
        SELECT code, name, status, created_at
        FROM permissions
        WHERE code IN
        <foreach collection="codes" item="code" open="(" separator="," close=")">
            #{code,jdbcType=VARCHAR}
        </foreach>
        ORDER BY code
    </select>
</mapper>
