<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.teaching.repo.mapper.SchoolClassMapper">
    <resultMap id="SchoolClassResultMap" type="${package}.infrastructure.teaching.repo.po.SchoolClassPO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="grade_name" property="gradeName"/>
        <result column="grade_id" property="gradeId"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByGradeIdAndId" resultMap="SchoolClassResultMap">
        SELECT id, name, grade_name, grade_id, status, created_at
        FROM school_classes
        WHERE grade_id = #{gradeId} AND id = #{id}
    </select>

    <select id="countByGradeIdAndNameIgnoreCase" resultType="long">
        SELECT COUNT(*)
        FROM school_classes
        WHERE grade_id = #{gradeId} AND LOWER(name) = LOWER(#{name})
    </select>
</mapper>
