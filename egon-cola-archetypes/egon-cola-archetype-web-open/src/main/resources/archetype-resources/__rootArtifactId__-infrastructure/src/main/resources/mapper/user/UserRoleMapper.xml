<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.user.repo.mapper.UserRoleMapper">
    <resultMap id="UserRoleResultMap" type="${package}.infrastructure.user.repo.po.UserRolePO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="role_id" property="roleId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByUserId" resultMap="UserRoleResultMap">
        SELECT id, user_id, role_id, created_at
        FROM user_roles
        WHERE user_id = #{userId}
        ORDER BY role_id ASC, id ASC
    </select>

    <select id="selectByRoleIds" resultMap="UserRoleResultMap">
        SELECT id, user_id, role_id, created_at
        FROM user_roles
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        ORDER BY user_id ASC, role_id ASC, id ASC
    </select>

    <select id="countByUserIdAndRoleId" resultType="long">
        SELECT COUNT(*)
        FROM user_roles
        WHERE user_id = #{userId} AND role_id = #{roleId}
    </select>
</mapper>
