<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.user.repo.mapper.RolePermissionMapper">
    <resultMap id="RolePermissionResultMap" type="${package}.infrastructure.user.repo.po.RolePermissionPO">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="permission_id" property="permissionId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByRoleId" resultMap="RolePermissionResultMap">
        SELECT id, role_id, permission_id, created_at
        FROM role_permissions
        WHERE role_id = #{roleId}
        ORDER BY permission_id ASC, id ASC
    </select>

    <select id="selectByRoleIds" resultMap="RolePermissionResultMap">
        SELECT id, role_id, permission_id, created_at
        FROM role_permissions
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        ORDER BY role_id ASC, permission_id ASC, id ASC
    </select>

    <select id="countByRoleIdAndPermissionId" resultType="long">
        SELECT COUNT(*)
        FROM role_permissions
        WHERE role_id = #{roleId} AND permission_id = #{permissionId}
    </select>
</mapper>
