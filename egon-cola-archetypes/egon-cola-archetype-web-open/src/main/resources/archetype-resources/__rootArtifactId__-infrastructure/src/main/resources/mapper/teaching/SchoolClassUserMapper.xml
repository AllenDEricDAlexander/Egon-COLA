<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.teaching.repo.mapper.SchoolClassUserMapper">
    <resultMap id="SchoolClassUserResultMap" type="${package}.infrastructure.teaching.repo.po.SchoolClassUserPO">
        <id column="id" property="id"/>
        <result column="grade_id" property="gradeId"/>
        <result column="user_id" property="userId"/>
        <result column="school_class_id" property="schoolClassId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByGradeIdAndSchoolClassId" resultMap="SchoolClassUserResultMap">
        SELECT id, grade_id, user_id, school_class_id, created_at
        FROM school_class_users
        WHERE grade_id = #{gradeId} AND school_class_id = #{schoolClassId}
        ORDER BY user_id ASC, id ASC
    </select>

    <select id="countByGradeIdAndSchoolClassIdAndUserId" resultType="long">
        SELECT COUNT(*)
        FROM school_class_users
        WHERE grade_id = #{gradeId}
          AND school_class_id = #{schoolClassId}
          AND user_id = #{userId}
    </select>
</mapper>
