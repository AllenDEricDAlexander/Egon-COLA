<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.teaching.repo.dao.GradeDAO">
    <resultMap id="GradeResultMap" type="${package}.infrastructure.teaching.repo.po.GradePO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
    </resultMap>
    <select id="selectByCode" resultMap="GradeResultMap">
        SELECT id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
               code, name, status FROM grades WHERE code = #{code}
    </select>
    <select id="countByCode" resultType="long">SELECT COUNT(*) FROM grades WHERE code = #{code}</select>
</mapper>
