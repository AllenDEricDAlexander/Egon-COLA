<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${package}.infrastructure.teaching.repo.dao.SchoolClassDAO">
    <resultMap id="SchoolClassResultMap" type="${package}.infrastructure.teaching.repo.po.SchoolClassPO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="name" property="name"/>
        <result column="grade_name" property="gradeName"/>
        <result column="grade_id" property="gradeId"/>
        <result column="status" property="status"/>
    </resultMap>
    <select id="selectByGradeIdAndId" resultMap="SchoolClassResultMap">
        SELECT id, tenant_id, create_user_id, create_time, update_user_id, update_time, is_deleted,
               name, grade_name, grade_id, status FROM school_classes
        WHERE grade_id = #{gradeId} AND id = #{id}
    </select>
    <select id="countByGradeIdAndNameIgnoreCase" resultType="long">
        SELECT COUNT(*) FROM school_classes
        WHERE grade_id = #{gradeId} AND LOWER(name) = LOWER(#{name})
    </select>
</mapper>
